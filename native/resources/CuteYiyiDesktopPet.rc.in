#include "resource.h"

// The file is UTF-8; force rc.exe to preserve Chinese version strings.
#pragma code_page(65001)

// CMake copies the selected public/private ICO next to this generated resource.
IDI_CUTE_YIYI_APP ICON "CuteYiyiDesktopPet.ico"

// Embed the hand-authored manifest so DPI awareness takes effect before WinMain.
1 24 "CloudYiAssistant.manifest"

1 VERSIONINFO
 FILEVERSION 0,11,8,0
 PRODUCTVERSION 0,11,8,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "云依助手项目\0"
            VALUE "FileDescription", "云依助手\0"
            VALUE "FileVersion", "0.11.8.0\0"
            VALUE "InternalName", "CuteYiyiDesktopPet\0"
            VALUE "LegalCopyright", "Copyright (c) 2026\0"
            VALUE "OriginalFilename", "CuteYiyiDesktopPet.exe\0"
            VALUE "ProductName", "云依助手\0"
            VALUE "ProductVersion", "0.11.8\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
